                  },
                  "n_min": {
                    "label": "n_min",
                    "type": "int",
                    "value": 0,
                    "formula": "=MAX(0, CEILING((In_H - (Gap_Max - Margin))/MAX(Gap_Max - Margin + Thickness, 0.001), 1))",
