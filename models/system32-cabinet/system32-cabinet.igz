                    "access": "none"
                  },
                  "z_first": {
                    "label": "z_first",
                    "type": "length",
                    "value": 0.0,
                    "formula": "=In_Low + (In_H - (MAX(Holes_K, 1) - 1)*Raster)/2",
                    "access": "none"
                  },
                  "margin": {
                    "label": "margin",
                    "type": "length",
                    "value": 0.0,
                    "formula": "=Raster/2",
                    "access": "none"
                  },
                  "groove_w": {
