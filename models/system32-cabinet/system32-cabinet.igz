                  "n": {
                    "label": "Shelves (from the height)",
                    "type": "int",
                    "value": 0,
                    "formula": "=IF(Shelf_Mode=\"auto\", N_Min, Shelves)",
                    "access": "view",
                    "section": "Shelves",
                    "show_if": "=Shelf_Mode=\"auto\"",
                    "min": 0.0,
                    "max": 50.0
                  },
                  "gap": {
                    "label": "Gap between shelves",
                    "type": "length",
                    "value": 0.0,
                    "formula": "=(In_H - N*Thickness)/(N + 1)",
                    "access": "view",
                    "section": "Shelves"
                  },
                  "warning": {
                    "label": "Shelf warning",
                    "type": "string",
                    "value": "",
                    "formula": "=IF(AND(Shelf_Mode=\"auto\", N_Min > N_Max), \"Smallest and largest gap cannot both be kept at this height.\", IF(AND(Shelf_Mode=\"fixed\", OR(Gap < Gap_Min, Gap > Gap_Max)), \"The gap between the shelves is outside the smallest/largest gap.\", \"\"))",
                    "access": "warn",
                    "section": "Shelves"
                  },
                  "drill": {
                    "label": "Drill hole rows",
                    "type": "bool",
                    "value": true,
                    "formula": null,
                    "access": "textbox",
                    "section": "Holes (System 32)"
                  },
                  "row_front": {
                    "label": "Front row from the front edge",
                    "type": "length",
                    "value": 0.037,
                    "formula": null,
                    "access": "textbox",
                    "section": "Holes (System 32)",
                    "show_if": "=Drill",
                    "min": 0.01,
                    "max": 0.2
                  },
                  "row_back": {
                    "label": "Back row from the front edge",
                    "type": "length",
                    "value": 0.0,
                    "formula": "=Row_Front + FLOOR((IF(Back_Panel, Back_Y, LenY) - 2*Row_Front)/Raster, 1)*Raster",
                    "access": "view",
                    "section": "Holes (System 32)",
                    "show_if": "=Drill"
                  },
                  "hole_d": {
