                      "section": "Holes (System 32)",
                      "show_if": "=Drill",
                      "min": 0.002,
                      "max": 0.05
                    },
                    "edge_min": {
                      "label": "Smallest distance first/last hole to bottom/top",
                      "type": "length",
                      "value": 0.032,
                      "formula": null,
                      "access": "textbox",
                      "section": "Holes (System 32)",
                      "show_if": "=Drill",
                      "min": 0.01,
                      "max": 0.2
                    },
                    "holes_k": {
                      "label": "Holes per row",
                      "type": "int",
                      "value": 0,
                      "formula": "=MAX(0, FLOOR((In_H - 2*Edge_Min)/Raster, 1) + 1)",
                      "access": "view",
                      "section": "Holes (System 32)",
                      "show_if": "=Drill",
                      "min": 0.0
                    },
                    "raster": {
                      "label": "Hole raster",
                      "type": "length",
                      "value": 0.032,
                      "formula": null,
                      "access": "none"
                    },
                    "z_bottom": {
                      "label": "z_bottom",
                      "type": "length",
                      "value": 0.0,
                      "formula": "=IF(Plinth, Plinth_H, 0)",
                      "access": "none"
                    },
                    "in_low": {
                      "label": "in_low",
                      "type": "length",
                      "value": 0.0,
                      "formula": "=Z_Bottom + Thickness",
                      "access": "none"
                    },
                    "in_top": {
                      "label": "in_top",
                      "type": "length",
                      "value": 0.0,
                      "formula": "=LenZ - Thickness",
                      "access": "none"
                    },
                    "in_h": {
                      "label": "in_h",
                      "type": "length",
                      "value": 0.0,
                      "formula": "=In_Top - In_Low",
                      "access": "none"
                    },
                    "z_first": {
                      "label": "z_first",
                      "type": "length",
                      "value": 0.0,
                      "formula": "=In_Low + (In_H - (MAX(Holes_K, 1) - 1)*Raster)/2",
                      "access": "none"
                    },
                    "margin": {
                      "label": "margin",
                      "type": "length",
                      "value": 0.0,
                      "formula": "=Raster/2",
                      "access": "none"
                    },
                    "groove_w": {
                      "label": "groove_w",
                      "type": "length",
                      "value": 0.0,
                      "formula": "=Back_Thick + 0.001",
                      "access": "none"
                    },
                    "back_y": {
                      "label": "back_y",
                      "type": "length",
                      "value": 0.0,
                      "formula": "=LenY - Back_Inset - Groove_W",
                      "access": "none"
                    },
                    "fields": {
                      "label": "fields",
                      "type": "int",
                      "value": 0,
                      "formula": "=Divs + 1",
                      "access": "none"
                    },
                    "field_w": {
                      "label": "field_w",
                      "type": "length",
                      "value": 0.0,
                      "formula": "=(LenX - (Divs + 2)*Thickness)/(Divs + 1)",
                      "access": "none"
                    },
                    "n_min": {
                      "label": "n_min",
                      "type": "int",
                      "value": 0,
                      "formula": "=MAX(0, CEILING((In_H - (Gap_Max - Margin))/MAX(Gap_Max - Margin + Thickness, 0.001), 1))",
                      "access": "none"
                    },
                    "n_max": {
                      "label": "n_max",
                      "type": "int",
                      "value": 0,
                      "formula": "=FLOOR((In_H - (Gap_Min + Margin))/(Gap_Min + Margin + Thickness), 1)",
                      "access": "none"
                    }
                  },
